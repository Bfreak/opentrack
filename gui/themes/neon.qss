/* TrackHat theme prototype B: "Neon" - stylised; gradients, glow borders, techy type.
@window = #09080D
@windowtext = #F3E8FF
@base = #050507
@alternatebase = #120C1C
@text = #F3E8FF
@button = #1A1029
@buttontext = #F3E8FF
@highlight = #B026FF
@highlightedtext = #FFFFFF
@tooltipbase = #140B22
@tooltiptext = #F3E8FF
@light = #3B1F5E
@midlight = #2A1846
@mid = #4C2A7A
@dark = #050507
@shadow = #000000
@link = #D8B4FE
@placeholdertext = #6E5A8A
@disabledtext = #5A4F6B
*/

QWidget { font-family: "Bahnschrift", "Segoe UI"; font-size: 9pt; color: #F3E8FF; }
QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0.4, y2:1, stop:0 #1A0B2E, stop:0.45 #0B0910, stop:1 #07070A);
}

QGroupBox {
    background: rgba(22, 12, 36, 210); border: 1px solid #3B1F5E; border-top: 2px solid #9333EA;
    border-radius: 3px; margin-top: 16px; padding: 10px 6px 6px 6px;
}
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 1px 8px;
    color: #FFFFFF; background: #9333EA; border-radius: 2px; font-weight: 700;
}

QPushButton, QToolButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2A1846, stop:1 #160D26);
    border: 1px solid #6D28D9; border-radius: 3px; padding: 6px 12px; color: #F3E8FF; font-weight: 600;
}
QPushButton:hover, QToolButton:hover {
    border: 1px solid #E879F9;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3B1F66, stop:1 #1E1033);
}
QPushButton:pressed, QToolButton:pressed { background: #4C1D95; }
QPushButton:checked, QToolButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C3AED, stop:1 #C026D3); border-color: #F0ABFC;
}
QPushButton:disabled, QToolButton:disabled { color: #5A4F6B; background: #0F0B16; border-color: #241A33; }

#btnStartTracker {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C3AED, stop:1 #C026D3);
    border: 1px solid #F0ABFC; color: #FFFFFF; font-weight: 800; font-size: 10pt;
}
#btnStartTracker:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8B5CF6, stop:1 #D946EF); }
#btnStartTracker:disabled { background: #1A1226; border-color: #2D1F42; color: #6E5A8A; }
#btnStopTracker { font-size: 10pt; font-weight: 800; }
#btnStopTracker:enabled { border: 1px solid #F472B6; color: #FBCFE8; }
#btnHeadTest {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E1033, stop:0.5 #3B1F66, stop:1 #1E1033);
    border: 1px solid #A855F7;
}

QComboBox {
    background: #120C1C; border: 1px solid #4C2A7A; border-radius: 3px; padding: 4px 8px; font-weight: 600;
}
QComboBox:hover, QComboBox:focus { border-color: #E879F9; }
QComboBox QAbstractItemView {
    background: #120C1C; border: 1px solid #9333EA; outline: 0;
    selection-background-color: #9333EA; selection-color: #FFFFFF;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background: #050507; border: 1px solid #3B1F5E; border-radius: 3px; padding: 3px 6px;
    selection-background-color: #B026FF;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #E879F9; background: #0D0716; }

QCheckBox, QRadioButton { spacing: 7px; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #6D28D9; background: #050507; }
QCheckBox::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #E879F9; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8B5CF6, stop:1 #D946EF); border-color: #F0ABFC;
}

QTabWidget::pane { border: 1px solid #3B1F5E; border-top: 2px solid #9333EA; background: rgba(22, 12, 36, 210); top: -2px; }
QTabBar::tab {
    background: #120C1C; color: #A78BCA; padding: 7px 14px; margin-right: 2px;
    border: 1px solid #2D1F42; border-bottom: none; border-top-left-radius: 3px; border-top-right-radius: 3px; font-weight: 600;
}
QTabBar::tab:hover { color: #F3E8FF; border-color: #6D28D9; }
QTabBar::tab:selected {
    color: #FFFFFF; border-color: #9333EA;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7C3AED, stop:1 #3B1F66);
}

QSlider::groove:horizontal { height: 4px; background: #241A33; border-radius: 2px; }
QSlider::sub-page:horizontal { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C3AED, stop:1 #D946EF); border-radius: 2px; }
QSlider::handle:horizontal { background: #F3E8FF; width: 12px; height: 16px; margin: -6px 0; border: 2px solid #C026D3; border-radius: 3px; }

QScrollBar:vertical { background: #08060C; width: 10px; }
QScrollBar:horizontal { background: #08060C; height: 10px; }
QScrollBar::handle { background: #3B1F5E; border-radius: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #A855F7; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QMenu { background: #0F0A18; border: 1px solid #9333EA; padding: 4px; }
QMenu::item { padding: 5px 20px; }
QMenu::item:selected { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C3AED, stop:1 #C026D3); color: #FFFFFF; }
QMenu::separator { height: 1px; background: #3B1F5E; margin: 4px 8px; }

QToolTip { background: #140B22; color: #F3E8FF; border: 1px solid #E879F9; padding: 4px; }
QHeaderView::section { background: #1A1029; color: #D8B4FE; border: none; border-bottom: 1px solid #6D28D9; padding: 4px; font-weight: 600; }
QTableView, QListView, QTreeView {
    background: #050507; border: 1px solid #3B1F5E; gridline-color: #1E1530;
    selection-background-color: #9333EA; selection-color: #FFFFFF;
}
QProgressBar { background: #050507; border: 1px solid #3B1F5E; border-radius: 3px; text-align: center; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C3AED, stop:1 #D946EF); }

spline_detail--spline_widget {
    qproperty-plotColor: #10081C; qproperty-plotDisabledColor: #0C0A10;
    qproperty-gridColor: rgba(217, 70, 239, 70); qproperty-gridDisabledColor: rgba(110, 90, 138, 40);
}
